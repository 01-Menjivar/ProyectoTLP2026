// Caso: operadores aritméticos, precedencia, paréntesis y signo negativo
entero a = 10;
entero b = 3;
entero suma = a + b;
entero resta = a - b;
entero producto = a * b;
entero cociente = a / b;
entero resto = a % b;
entero mezcla = 2 + 3 * 4;
entero agrupado = (2 + 3) * 4;
entero negativo = -a;
decimal promedio = (a + b) / 2.0;

imprimir(mezcla);
imprimir(agrupado);
imprimir(promedio);
